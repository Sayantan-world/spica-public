# Public template for local package / cache paths.
# Copied to .packages.env.sh on first setup (that file is gitignored).
export PACKAGES_DIR="${PACKAGES_DIR:-$HOME/.spica-packages}"

export UV_CACHE_DIR="${PACKAGES_DIR}/uv-cache"
export UV_PYTHON_INSTALL_DIR="${PACKAGES_DIR}/uv-python"
export UV_TOOL_DIR="${PACKAGES_DIR}/uv-tools"
export UV_INSTALL_DIR="${PACKAGES_DIR}/bin"
export UV_INDEX_STRATEGY="unsafe-best-match"
export HF_HOME="${PACKAGES_DIR}/hf-cache"
export HUGGINGFACE_HUB_CACHE="${PACKAGES_DIR}/hf-cache"
export TRANSFORMERS_CACHE="${PACKAGES_DIR}/hf-cache"
export SENTENCE_TRANSFORMERS_HOME="${PACKAGES_DIR}/hf-cache"
export XDG_CACHE_HOME="${PACKAGES_DIR}/xdg-cache"
export NPM_CONFIG_CACHE="${PACKAGES_DIR}/npm-cache"
export PNPM_HOME="${PACKAGES_DIR}/pnpm"
export npm_config_store_dir="${PACKAGES_DIR}/pnpm-store"

export PATH="${PACKAGES_DIR}/bin:${PACKAGES_DIR}/node/bin:${PACKAGES_DIR}/pnpm:${PACKAGES_DIR}/spica/bin:${PATH}"

export SPICA_VENV="${PACKAGES_DIR}/spica"
