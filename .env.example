# Copy to .env and fill in your values.
# Settings here override the defaults in config/settings.py.

# PostgreSQL (accounts, uploads, memory chunks, chat)
DATABASE_URL=postgresql://spica:spica@127.0.0.1:5432/spica
LOGS_DIR=.logs
USER_DATA_DIR=backend/process_user_data/.files
# Shared Magpie WAVs for picture-board phrases (generated once, reused by all users)
PHRASE_AUDIO_DIR=data/.phrase_audio

# Account text processing + chat (OpenAI Responses API)
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_INPUT_TOKENS=4096
OPENAI_CHAT_MAX_INPUT_TOKENS=8192
OPENAI_KEY_PATH=backend/.llm_enpoints/.openai_key
# OPENAI_API_KEY=   # optional; otherwise read from OPENAI_KEY_PATH

# NVIDIA NIM speech — Riva gRPC (grpc.nvcf.nvidia.com), not HTTP.
NIM_KEY_PATH=backend/.llm_enpoints/.nim_key
NIM_GRPC_SERVER=grpc.nvcf.nvidia.com:443
NIM_WHISPER_MODEL=openai/whisper-large-v3
NIM_WHISPER_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
NIM_WHISPER_LANGUAGE=en
# Magpie multilingual (zeroshot needs a voice prompt clip)
NIM_MAGPIE_MODEL=nvidia/magpie-tts-multilingual
NIM_MAGPIE_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
NIM_MAGPIE_VOICE=Magpie-Multilingual.EN-US.Jason
NIM_MAGPIE_LANGUAGE=en-US

# Account memory embeddings (pgvector / nomic)
USER_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
USER_EMBED_DIM=768

MAX_CHAT_SESSIONS_PER_USER=5
MAX_CHAT_TURNS_PER_SESSION=20
