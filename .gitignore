!.env.example
!.pre-commit-config.yaml
!.dockerignore
!frontend/.gitignore
!.gitkeep
!**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/
env/
spica/

